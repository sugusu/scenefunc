  "available_source_knowledge": [
    {
      "condition": "为两位旅客短期住宿设计的紧凑布达佩斯公寓，衣物需要方便、快速取用。",
      "decision_id": "airbnp_open_clothing_access_for_short_stays",
      "principle": "在两人短期住宿的条件下，开放挂杆能方便快速取用经常使用的衣物，不必将所有衣物收进封闭柜内。",
      "scope": "Source supports open clothing strategy, not coordinates or complete dwelling."
    },
    {
      "condition": "四口之家已有家具，希望主要空间供共同生活。",
      "decision_id": "fhouse_existing_furniture_shared_living",
      "principle": "为容纳既有家具并优先共同生活，F-House采用了较开放的空间组织。",
      "scope": "Source shared-living condition only. Divider and reduced-distraction counterfactual excluded from professional supervision."
    },
    {
      "condition": "年轻伴侣的约30平方米住宅原先分为四个昏暗房间，改造同时追求明亮起居、私密空间与收纳。",
      "decision_id": "guilbault_consolidated_storage_for_continuous_living_space",
      "principle": "在紧凑住宅中集中组织储物与技术需求，可以为连续的起居空间释放位置。",
      "scope": "First cabinet addition anchors a source-linked three-cabinet sequence; later steps remain ordinary actions."
    },
    {
      "condition": "家庭成员长大、居住安排会变化。",
      "decision_id": "michelet_adapt_family_lifecycle",
      "principle": "住户生活阶段变化后，可将原卧室调整为新的用途；Michelet报道原长子卧室后来改为办公室。",
      "scope": "Source supports role adaptation; bed removal and all poses are reconstruction, not historical operations."
    },
    {
      "condition": "同一生活区需吃饭、聚会并偶尔容纳留宿者。",
      "decision_id": "paper_table_mobility_for_overnight_guest",
      "principle": "同一餐厨起居区需要在日常用餐、待客和偶尔留宿之间转换时，可移动的桌子便于按活动腾出空间。",
      "scope": "Moving table expresses activity-dependent reserve release; no verified bed deployment."
    },
    {
      "condition": "住户重视可变配置，不希望固定在单一家具布置中。",
      "decision_id": "waterloo_separable_tables_for_changing_activities",
      "principle": "住户需要灵活改变家具配置时，两张可分可合的桌子允许空间随不同活动重新组织。",
      "scope": "Source rationale attached to actual table configuration change, not preparatory chair relocation."
    }
  ],
  "design_request": "研究者重建任务：为两位短住旅客完成6米×5米房间的家具布置。已有固定厨房操作台、灶台、水槽和三件卫浴设施；保留房壳、开口和这些设施。使用目录补齐睡眠、起居、两人吃饭、冷藏及便于取放衣物所需的家具，保持入口、餐位、厨卫与窗前可接近。不得删除必需角色或缩放资产。人数与短住用途来自项目说明；矩形房壳、精确尺寸、设施、替代家具及具体要求整理为研究者重建，不是原住户任务书。",
